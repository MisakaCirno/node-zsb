{
  "name": "node-zsb",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run typecheck && bun run build:web",
    "build:web": "bun run scripts/build-web.ts",
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && tsc -p tsconfig.tests.json",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun run scripts/run-playwright.ts",
    "test:e2e:headed": "bun run scripts/run-playwright.ts --headed",
    "test:e2e:ui": "bun run scripts/run-playwright.ts --ui"
  },
  "dependencies": {
    "@elysiajs/node": "^1.4.3",
    "@elysiajs/openapi": "^1.4.13",
    "elysia": "^1.4.22",
    "konva": "^10.2.0",
    "sharp": "^0.34.5",
    "skia-canvas": "^3.0.8",
    "thumbhash": "^0.1.1",
    "xiv-strat-board": "^0.2.3"
  },
  "trustedDependencies": [
    "skia-canvas"
  ],
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.0.9",
    "typescript": "^5.9.3"
  }
}
