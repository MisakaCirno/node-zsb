{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "strictNullChecks": false
  },
  "include": [
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/editor.spec.ts",
    "tests/unit/**/*.ts"
  ]
}
